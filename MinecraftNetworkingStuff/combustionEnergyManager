local component = require("component")
local engine = component.getPrimary("ntm_combustion_engine")
local gpu = component.gpu
local term = require("term")
local color = require("colors")
local status = false
term.clear()

function drawContainer (gpu,right,percent,label)
    local w,h = gpu.getViewport()
    gpu.setForeground(color.black)
    term.setCursor(right,1)
    term.write(label)
    term.setCursor(right,2)
    term.write("%".. math.ceil(percent))
    gpu.fill(right,3,10,h-5,"█")
    gpu.setForeground(color.white)
    local powerHeight = math.ceil((h-8)*((100-percent)/100))
    gpu.fill(right + 1,4,8,powerHeight,"█")
end

while true do
    local energy = (engine.getPower() / 2500000) * 100
    local fuel,fuelm = engine.getFluid()
    fuel = (fuel/fuelm) * 100

    if energy < 50 and status == false then
        engine.start()
        status = true
    end
    if energy > 70 and status == true then
        engine.stop()
        status = false
    end

    drawContainer(gpu,3,energy,"energy")
    drawContainer(gpu,15,fuel,"fuel")

    gpu.setForeground(color.black)
    term.setCursor(28,1)
    term.write("status")
    term.setCursor(28,2)
    gpu.fill(28,3,5,5,"█")
    if status == true then
        term.write("Active")
    end
    if status == false then
        term.write("Inactive")
        gpu.setForeground(color.white)
        gpu.fill(29,4,3,3,"█")
    end
    os.sleep(5)
    term.clear()
end